<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WsaManager_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WsaManager_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24,16,24,16" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
        <TextBox x:Name="AdbPathBox" Header="ADB path override" PlaceholderText="Use Android SDK or PATH adb" Text="{Binding AdbPathDraft, Mode=TwoWay}" />
        <Button Click="ChooseAdb_Click" Content="Choose adb.exe" />
        <Button Click="SaveAdb_Click" Content="Save ADB path" />
        <TextBox x:Name="EndpointBox" Header="Manual endpoint override" PlaceholderText="127.0.0.1:58526" Text="{Binding ManualEndpointDraft, Mode=TwoWay}" />
        <Button Click="SaveEndpoint_Click" Content="Save endpoint" />
    </StackPanel>
</Page>
