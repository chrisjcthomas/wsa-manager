<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WsaManager_WinUI.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24,16,24,16" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Diagnostics" />
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Click="Refresh_Click" Icon="Refresh" Label="Run checks" />
            <AppBarButton Click="Clear_Click" Icon="Delete" Label="Clear" />
        </CommandBar>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding StatusText}" Message="{Binding ConnectionStatusText}" />
        <ListView ItemsSource="{Binding Diagnostics}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Timestamp}" />
                        <TextBlock Grid.Column="1" Text="{Binding Source}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Message}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
